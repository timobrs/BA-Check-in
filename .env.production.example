BACKEND_IMAGE=ghcr.io/gruppe5-ba/app-backend:latest
BACKEND_UID=1000
BACKEND_GID=1000
POSTGRES_DB=ba_check_in
POSTGRES_USER=ba_check_in
POSTGRES_PASSWORD=replace-with-a-long-random-password

ACTIVATION_CODE_HMAC_SECRET=replace-with-a-base64-encoded-random-secret
NTAG424_KEY_VERSION=v1
NTAG424_METADATA_MASTER_KEY_FILE=./secrets/ntag424-metadata-master-key.hex
NTAG424_AUTHENTICATION_MASTER_KEY_FILE=./secrets/ntag424-authentication-master-key.hex

JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
